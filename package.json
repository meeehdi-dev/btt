    "drizzle-orm": "0.45.4",
    "effect": "4.1.2",
    "h3": "1.15.11",
    "nuxt": "4.6.4",
    "parse-duration-ms": "0.1.0",
    "pg": "8.23.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "6.0.10",
