{
  "name": "btt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "check:duplicates": "jscpd --baseline .jscpd-baseline.json --fail-on-new-clones 0",
    "check:unused": "DATABASE_URL=postgres://knip:knip@localhost:5432/knip knip",
    "typecheck": "nuxt typecheck",
    "typecheck:tsgo": "tsgo --project tsconfig.tsgo.json --noEmit",
    "test": "vitest run",
    "check:workflow": "node scripts/check-workflow-docs.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
