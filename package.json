    "happy-dom": "21.0.4",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "pnpm": "12.17.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.14"
  },
